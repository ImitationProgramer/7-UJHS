# 서버 전용. 실제 키를 Git이나 클라이언트에 넣지 마세요.
TMAP_APP_KEY=
OPENAI_API_KEY=
# 시연 장소가 성동구 밖일 때 왕십리역을 가상 출발지로 사용 (0 또는 미설정: 실제 위치)
# NAV_DEMO_MODE=1
# 선택: Realtime 모델 (기본 gpt-realtime-2.1)
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# 다른 호스트에서 화면을 열 때만 설정
# NAV_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
